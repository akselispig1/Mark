# Copy to .env and fill in. Mark's brain uses your existing Claude Code login - no API key needed.
# JARVIS_VOICE_MODEL=claude-haiku-4-5   (fast voice brain)
# JARVIS_WORKER_MODEL=claude-opus-5     (background tasks)
# JARVIS_VOICE=en-GB-RyanNeural          (Edge neural voice)

# --- Phone calls (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...          # your Twilio number
MY_PHONE=+1...             # your mobile
PUBLIC_URL=               # leave empty on the PC (a free tunnel is opened automatically); on AWS: https://<your domain>
RELAY_SECRET=              # any long random string
# Optional phone voice, e.g. JARVIS_TTS_PROVIDER=ElevenLabs  JARVIS_PHONE_VOICE=<voice id>

# --- Free push calls from your phone ---
JARVIS_URL=               # your Tailscale address (PC) or https://<ip-dashes>.sslip.io (AWS)

# --- Free Telegram calls (recommended) ---
TELEGRAM_API_ID=           # from my.telegram.org, signed in as Mark's account
TELEGRAM_API_HASH=
TELEGRAM_CALL_USER=        # YOUR Telegram @username (who Mark calls)

# Mark's own long-lived Claude login: run  claude setup-token  and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# --- Alexa skill ("Alexa, open Mark") ---
ALEXA_SKILL_ID=           # amzn1.ask.skill.… from the Alexa developer console
ALEXA_VOICE=              # optional: Brian (British male) — otherwise the Echo's own voice

# Hide Mark's own browser window on the PC (it is always hidden on a server)
JARVIS_BROWSER_HEADLESS=

# Google (real Google Docs). See the README for the ten-click setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
